# Copy to .env and fill in your own key (get it from https://dashboard.clerk.com).
# The dev server reads this file ONLY at startup: after creating/changing it,
# fully stop the server (Ctrl+C) and run `npm run dev` again from this folder.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# Optional: point the app at a deployed API instead of the /api dev proxy.
# VITE_API_URL=
